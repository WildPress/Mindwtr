# Mindwtr Cloud example environment.
# Copy to .env for local development and replace placeholders before use.

# Network binding
HOST=0.0.0.0
PORT=8787
# NODE_ENV=production

# Authentication
# Use long random bearer tokens. Comma-separate multiple tokens.
MINDWTR_CLOUD_AUTH_TOKENS=replace-with-a-long-random-token
# MINDWTR_CLOUD_AUTH_TOKENS_FILE=/run/secrets/mindwtr_cloud_tokens
# Deprecated legacy single-token aliases; prefer MINDWTR_CLOUD_AUTH_TOKENS.
# MINDWTR_CLOUD_TOKEN=
# MINDWTR_CLOUD_TOKEN_FILE=
# Development/testing only.
# MINDWTR_CLOUD_ALLOW_ANY_TOKEN=false
# MINDWTR_CLOUD_ANY_TOKEN_MAX_NAMESPACES=32

# Browser origin and storage
MINDWTR_CLOUD_CORS_ORIGIN=http://localhost:5173
MINDWTR_CLOUD_DATA_DIR=./data

# Reverse proxy handling for auth-failure rate limiting
MINDWTR_CLOUD_TRUST_PROXY_HEADERS=false
# MINDWTR_CLOUD_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Request limits
# Numeric values are strict decimal integers. Invalid values stop startup and name the exact key.
MINDWTR_CLOUD_MAX_BODY_BYTES=2000000
MINDWTR_CLOUD_MAX_ATTACHMENT_BYTES=50000000
MINDWTR_CLOUD_REQUEST_TIMEOUT_MS=30000
# Failures and slow requests are logged by default. Enable this only when every
# privacy-safe request completion should be logged.
MINDWTR_CLOUD_LOG_ALL_REQUESTS=false
MINDWTR_CLOUD_SLOW_REQUEST_MS=1000
MINDWTR_CLOUD_MAX_TASK_TITLE_LENGTH=500
MINDWTR_CLOUD_MAX_TASK_QUICK_ADD_LENGTH=2000
MINDWTR_CLOUD_MAX_AREA_NAME_LENGTH=200
MINDWTR_CLOUD_MAX_ITEMS_PER_COLLECTION=50000

# Pagination and list shaping
MINDWTR_CLOUD_LIST_DEFAULT_LIMIT=200
MINDWTR_CLOUD_LIST_MAX_LIMIT=1000

# Rate limiting
MINDWTR_CLOUD_RATE_WINDOW_MS=60000
MINDWTR_CLOUD_RATE_MAX=120
MINDWTR_CLOUD_ATTACHMENT_RATE_MAX=120
MINDWTR_CLOUD_RATE_CLEANUP_MS=60000
MINDWTR_CLOUD_RATE_MAX_KEYS=10000
MINDWTR_CLOUD_AUTH_FAILURE_RATE_MAX=30

# Outbound reminder webhook (optional)
# When enabled, the server polls every namespace's task dates and digests and POSTs
# a JSON body to the webhook URL as each reminder comes due — a real push that does
# not depend on any client (phone/desktop) being awake. Off unless explicitly enabled.
# Payload: { event, kind, key, taskId?, projectId?, title, message, firedAt, namespace }
# kind is one of: task-reminder | due-repeat | task-review | project-review |
#                 digest-morning | digest-evening | weekly-review
MINDWTR_CLOUD_REMINDER_WEBHOOK_ENABLED=false
# The endpoint reminders are POSTed to (required when enabled).
# MINDWTR_CLOUD_REMINDER_WEBHOOK_URL=https://scheduler.example.com/hooks/mindwtr
# Optional bearer token, sent as an Authorization header on each POST.
# MINDWTR_CLOUD_REMINDER_WEBHOOK_TOKEN=
# How often the server checks for due reminders (min 1000).
MINDWTR_CLOUD_REMINDER_POLL_INTERVAL_MS=60000
# Cap on how far back a poll reaches, so a restart after downtime never dumps a
# backlog of stale reminders.
MINDWTR_CLOUD_REMINDER_MAX_LOOKBACK_MS=600000
# Per-POST timeout (min 1).
MINDWTR_CLOUD_REMINDER_WEBHOOK_TIMEOUT_MS=10000
# Which per-task date reminders to emit.
MINDWTR_CLOUD_REMINDER_START_ENABLED=true
MINDWTR_CLOUD_REMINDER_DUE_ENABLED=true
MINDWTR_CLOUD_REMINDER_REVIEW_ENABLED=true
# Digests. Times are "HH:mm" in the SERVER's local timezone (set TZ accordingly);
# weekday is 0=Sunday .. 6=Saturday. Per-task reminders fire on absolute task
# timestamps and are unaffected by the server timezone.
MINDWTR_CLOUD_REMINDER_DIGEST_MORNING_ENABLED=true
MINDWTR_CLOUD_REMINDER_DIGEST_MORNING_TIME=09:00
MINDWTR_CLOUD_REMINDER_DIGEST_EVENING_ENABLED=true
MINDWTR_CLOUD_REMINDER_DIGEST_EVENING_TIME=20:00
MINDWTR_CLOUD_REMINDER_WEEKLY_REVIEW_ENABLED=true
MINDWTR_CLOUD_REMINDER_WEEKLY_REVIEW_DAY=1
MINDWTR_CLOUD_REMINDER_WEEKLY_REVIEW_TIME=18:00
